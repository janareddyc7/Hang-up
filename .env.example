# Copy this file to .env.local and fill in the values for the services you use.
# Keep real keys and connection strings out of Git.

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=

# Sign-in email (required together when auth is configured)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAILS=

# AI replies (defaults are configured in the app)
AI_GATEWAY_API_KEY=
ACTOR_MODEL=
CLASSIFIER_MODEL=
# Use one of these instead if connecting a provider directly through its SDK.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ElevenLabs voice agent
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_IDS=
ELEVENLABS_WEBHOOK_SECRET=
HANGUP_LLM_SECRET=

# Scheduled jobs
CRON_SECRET=

# Phone practice is disabled unless both flags are explicitly enabled.
# Do not enable until adult review, consent, and provider setup are complete.
PRACTICE_CALLS_ENABLED=false
PRACTICE_CALLS_ADULT_REVIEWED=false
ELEVENLABS_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_ENCRYPTION_KEY=

# Research pilot is disabled until its instrument and protocol are reviewed.
PILOT_ENABLED=false

# Optional local development tools
DEMO_SEED_ENABLED=false
HANGUP_E2E_MODE=false
